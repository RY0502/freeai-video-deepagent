# Copy this file to .env and replace placeholders. Never commit .env.

# -----------------------------------------------------------------------------
# Base deep-agent framework (required when using its built-in LLM rotation)
# Rotation order: NVIDIA -> AnyAPI -> Requesty -> OpenRouter -> Hugging Face.
# -----------------------------------------------------------------------------
ANYAPI_AGENT_KEY_1=replace_me
# ANYAPI_AGENT_KEY_2=replace_me
REQUESTY_API_KEY=replace_me
NVIDIA_DEEP_AGENT_API_KEY_1=replace_me
# NVIDIA_DEEP_AGENT_API_KEY_2=replace_me
OPENROUTER_API_KEY=replace_me
HUGGINGFACE_API_KEY=replace_me
TAVILY_API_KEY=replace_me

# Optional base-framework overrides.
ANYAPI_DEEP_AGENT_MODEL=openai/gpt-5.5
NVIDIA_DEEP_AGENT_MODEL=z-ai/glm-5.2
REQUESTY_DEEP_AGENT_MODEL=nvidia/nemotron-3-super-120b-a12b
OPENROUTER_DEEP_AGENT_MODEL=nvidia/nemotron-3-super-120b-a12b
HUGGINGFACE_DEEP_AGENT_MODEL=zai-org/GLM-5.2
MAX_PARALLEL_SUBAGENTS=3
PROVIDER_RETRY_MAX=2
PROVIDER_RETRY_DELAY_MS=5000
PROVIDER_COOLDOWN_MS=120000

# -----------------------------------------------------------------------------
# Post-render Foley vision inspection. A timestamped contact sheet is checked
# before ElevenLabs generation. The free-tier vision orchestrator rotates its
# configured providers; NVIDIA numbered keys must use these exact names.
# GROQ_API_KEY[_n], HUGGINGFACE_API_KEY, or Cloudflare credentials may also
# provide fallback. Numbered Groq keys allow gaps and rotate after a bounded
# rate-limit cycle. Keep this timeout bounded because there are two passes.
# -----------------------------------------------------------------------------
NVIDIA_API_KEY_1=replace_me
# NVIDIA_API_KEY_2=replace_me
NVIDIA_VISION_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning
REQUEST_TIMEOUT_MS=60000
# GROQ_API_KEY_1=replace_me
# GROQ_API_KEY_2=replace_me
# GROQ_API_KEY=replace_me  # singular fallback when no numbered keys are set
# GROQ_VISION_MODEL=qwen/qwen3.6-27b
# CLOUDFLARE_API_TOKEN=replace_me
# CLOUDFLARE_ACCOUNT_ID=replace_me

# -----------------------------------------------------------------------------
# Agnes Video 2.5 Flash. Numbered keys are attempted in numeric order for a
# fresh submission only when a key is definitively rate/quota/credit limited.
# Accepted tasks retain their key fingerprint and always poll with that key.
# -----------------------------------------------------------------------------
AGNES_API_KEY_1=replace_me
# AGNES_API_KEY_2=replace_me
AGNES_BASE_URL=https://apihub.agnes-ai.com
AGNES_REQUEST_TIMEOUT_MS=60000
AGNES_POLL_INTERVAL_MS=30000
AGNES_POLL_WINDOW_MS=480000
AGNES_MAX_DOWNLOAD_BYTES=500000000

# -----------------------------------------------------------------------------
# Free.ai ACE-Step best-effort background music. Three retries follow the
# initial request; each generation attempt advances through this audio-only
# key pool. Exhaustion is persisted and assembly continues with Foley only.
# -----------------------------------------------------------------------------
FREE_AI_API_AUDIO_KEY_1=replace_me
# FREE_AI_API_AUDIO_KEY_2=replace_me
# FREE_AI_API_AUDIO_KEY_3=replace_me
FREE_AI_BASE_URL=https://api.free.ai
FREE_AI_REQUEST_TIMEOUT_MS=180000
FREE_AI_RETRY_DELAY_MS=6000
FREE_AI_MUSIC_MAX_DOWNLOAD_BYTES=67108864

# -----------------------------------------------------------------------------
# ElevenLabs Sound Effects API. This pool is used only for isolated Foley;
# definite key exhaustion rotates according to the existing Foley policy.
# -----------------------------------------------------------------------------
ELEVENLABS_API_KEY_1=replace_me
# ELEVENLABS_API_KEY_2=replace_me
ELEVENLABS_BASE_URL=https://api.elevenlabs.io
ELEVENLABS_REQUEST_TIMEOUT_MS=180000

# Media defaults. Prompt-specified supported style/aspect values override these
# for a new run; otherwise these exact defaults are locked into the plan.
# Styles: cinematic, animation, realistic, artistic, vintage, anime, film-noir,
# documentary, commercial, music-video. Ratios: 21:9, 16:9, 4:3, 1:1, 3:4, 9:16.
VIDEO_ASPECT_RATIO=16:9
VIDEO_STYLE=cinematic
VIDEO_FPS=24
VIDEO_OUTPUT_ROOT=./runs
# Music is deliberately quieter than prompt-derived foreground sound effects.
VIDEO_MUSIC_VOLUME=0.10
VIDEO_FOLEY_VOLUME=1.00

# -----------------------------------------------------------------------------
# YouTube upload (optional). The tool remains disabled unless the run uses the
# explicit --youtube flag AND YOUTUBE_UPLOAD_ENABLED=true. The LLM
# supplies title, description, tags, and category; these env values control the
# policy-sensitive publication settings.
# -----------------------------------------------------------------------------
YOUTUBE_UPLOAD_ENABLED=false
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=http://127.0.0.1:53682/oauth2/callback
YOUTUBE_REFRESH_TOKEN=
YOUTUBE_DEFAULT_PRIVACY=private
YOUTUBE_DEFAULT_MADE_FOR_KIDS=false
YOUTUBE_DEFAULT_CONTAINS_SYNTHETIC_MEDIA=true
